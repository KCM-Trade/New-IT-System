  "schemas": {
    "Basis": {
      "description": "Machine-readable statement of how every number was computed.",
      "properties": {
        "calc_version": {
          "default": 1,
          "title": "Calc Version",
          "type": "integer"
        },
        "currency": {
          "const": "USD",
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "day_boundary": {
          "const": "mt_server",
          "default": "mt_server",
          "title": "Day Boundary",
          "type": "string"
        },
        "exclude_open_positions": {
          "const": true,
          "default": true,
          "title": "Exclude Open Positions",
          "type": "boolean"
        },
        "netting": {
          "const": "net",
          "default": "net",
          "description": "Headline figure nets better fills against worse ones; comp_positive_usd is given alongside.",
          "title": "Netting",
          "type": "string"
        },
        "order_scope": {
          "const": "client_market_open_close",
          "default": "client_market_open_close",
          "title": "Order Scope",
          "type": "string"
        },
        "reference": {
          "const": "request_price",
          "default": "request_price",
          "title": "Reference",
          "type": "string"
        }
      },
      "title": "Basis",
      "type": "object"
    },
    "ClassRow": {
      "properties": {
        "cls": {
          "enum": [
            "no_plugin",
            "plugin_passthrough",
            "close_by",
            "so_first",
            "so_rest",
            "limit",
            "stop",
            "other_type",
            "sl",
            "tp",
            "market",
            "dealer",
            "other_reason"
          ],
          "title": "Cls",
          "type": "string"
        },
        "comp_net_usd": {
          "default": 0.0,
          "title": "Comp Net Usd",
          "type": "number"
        },
        "comp_positive_usd": {
          "default": 0.0,
          "title": "Comp Positive Usd",
          "type": "number"
        },
        "deals": {
          "default": 0,
          "title": "Deals",
          "type": "integer"
        },
        "lots": {
          "default": 0.0,
          "title": "Lots",
          "type": "number"
        }
      },
      "required": [
        "cls"
      ],
      "title": "ClassRow",
      "type": "object"
    },
    "Coverage": {
      "properties": {
        "complete": {
          "description": "False = the replica has not caught up to as_of; numbers are partial",
          "title": "Complete",
          "type": "boolean"
        },
        "earliest_srv_date": {
          "description": "First MT5 fill day; lower bound for date_from",
          "format": "date",
          "title": "Earliest Srv Date",
          "type": "string"
        },
        "ready_through_srv_date": {
          "description": "Latest as_of the replica fully covers (normally yesterday)",
          "format": "date",
          "title": "Ready Through Srv Date",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "replica_latest_fill_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Replica Latest Fill Utc"
        },
        "unmatched_deals": {
          "default": 0,
          "description": "Fills in range whose order row was not found (never dropped silently; not counted)",
          "title": "Unmatched Deals",
          "type": "integer"
        }
      },
      "required": [
        "earliest_srv_date",
        "ready_through_srv_date",
        "complete"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DelayStats": {
      "description": "Over counted fills only.",
      "properties": {
        "max_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Ms"
        },
        "median_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Ms"
        },
        "min_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Min Ms"
        },
        "n": {
          "default": 0,
          "title": "N",
          "type": "integer"
        },
        "p95_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95 Ms"
        }
      },
      "title": "DelayStats",
      "type": "object"
    },
    "ErrorDetail": {
      "properties": {
        "code": {
          "enum": [
            "SUBJECT_REQUIRED",
            "SUBJECT_AMBIGUOUS",
            "INVALID_LOGIN_SID",
            "SUBJECT_NOT_FOUND",
            "RANGE_INVALID",
            "RANGE_BEFORE_COVERAGE",
            "AS_OF_TOO_LATE",
            "SORT_NOT_ALLOWED",
            "VALIDATION_ERROR",
            "QUERY_TOO_LARGE",
            "BUSY",
            "UNKNOWN_CURRENCY",
            "UPSTREAM_TIMEOUT"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "ErrorResponse": {
      "properties": {
        "error": {
          "$ref": "#/components/schemas/ErrorDetail"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "ExcludedOpen": {
      "description": "Eligible fills left out because their position was still open at as_of (01 D13).",
      "properties": {
        "comp_net_usd_if_counted": {
          "default": 0.0,
          "title": "Comp Net Usd If Counted",
          "type": "number"
        },
        "deals": {
          "default": 0,
          "title": "Deals",
          "type": "integer"
        },
        "lots": {
          "default": 0.0,
          "title": "Lots",
          "type": "number"
        },
        "positions": {
          "default": 0,
          "title": "Positions",
          "type": "integer"
        }
      },
      "title": "ExcludedOpen",
      "type": "object"
    },
    "GroupRow": {
      "properties": {
        "comp_net_usd": {
          "default": 0.0,
          "title": "Comp Net Usd",
          "type": "number"
        },
        "comp_positive_usd": {
          "default": 0.0,
          "title": "Comp Positive Usd",
          "type": "number"
        },
        "deals": {
          "default": 0,
          "title": "Deals",
          "type": "integer"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "lots": {
          "default": 0.0,
          "title": "Lots",
          "type": "number"
        }
      },
      "required": [
        "key"
      ],
      "title": "GroupRow",
      "type": "object"
    },
    "Limits": {
      "properties": {
        "cache_ttl_s": {
          "title": "Cache Ttl S",
          "type": "integer"
        },
        "max_concurrent": {
          "title": "Max Concurrent",
          "type": "integer"
        },
        "max_deals": {
          "title": "Max Deals",
          "type": "integer"
        },
        "page_size_max": {
          "title": "Page Size Max",
          "type": "integer"
        },
        "query_budget_s": {
          "title": "Query Budget S",
          "type": "integer"
        },
        "statement_timeout_ms": {
          "title": "Statement Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "statement_timeout_ms",
        "query_budget_s",
        "max_deals",
        "max_concurrent",
        "cache_ttl_s",
        "page_size_max"
      ],
      "title": "Limits",
      "type": "object"
    },
    "OrderRow": {
      "description": "One in-range fill that has its order row. Fills whose order row is\nmissing are not rows; they only appear as ``coverage.unmatched_deals``.",
      "properties": {
        "account_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "mt4_users.GROUP; explains plugin_passthrough rows (01 D20)",
          "title": "Account Group"
        },
        "ccy": {
          "enum": [
            "CEN",
            "USD"
          ],
          "title": "Ccy",
          "type": "string"
        },
        "cls": {
          "enum": [
            "no_plugin",
            "plugin_passthrough",
            "close_by",
            "so_first",
            "so_rest",
            "limit",
            "stop",
            "other_type",
            "sl",
            "tp",
            "market",
            "dealer",
            "other_reason"
          ],
          "title": "Cls",
          "type": "string"
        },
        "comp_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Not truncated; negative = better fill",
          "title": "Comp Usd"
        },
        "counted": {
          "title": "Counted",
          "type": "boolean"
