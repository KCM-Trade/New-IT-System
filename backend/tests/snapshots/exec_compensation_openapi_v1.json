{
  "paths": {
    "/api/v1/exec-compensation/export": {
      "get": {
        "operationId": "get_export_api_v1_exec_compensation_export_get",
        "parameters": [
          {
            "description": "CRM client id (fxbackoffice.users.id); exclusive with login_sid",
            "in": "query",
            "name": "client_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CRM client id (fxbackoffice.users.id); exclusive with login_sid",
              "title": "Client Id"
            }
          },
          {
            "description": "One MT5 account, '5-<login>'; exclusive with client_id",
            "in": "query",
            "name": "login_sid",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "One MT5 account, '5-<login>'; exclusive with client_id",
              "title": "Login Sid"
            }
          },
          {
            "description": "First MT server day (inclusive)",
            "in": "query",
            "name": "date_from",
            "required": true,
            "schema": {
              "description": "First MT server day (inclusive)",
              "format": "date",
              "title": "Date From",
              "type": "string"
            }
          },
          {
            "description": "Last MT server day (inclusive); clipped to as_of",
            "in": "query",
            "name": "date_to",
            "required": true,
            "schema": {
              "description": "Last MT server day (inclusive); clipped to as_of",
              "format": "date",
              "title": "Date To",
              "type": "string"
            }
          },
          {
            "description": "Data cut-off MT server day; default = yesterday",
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Data cut-off MT server day; default = yesterday",
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {}
            },
            "description": "xlsx: 汇总 + 明细"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "SUBJECT_NOT_FOUND"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters / QUERY_TOO_LARGE"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UNKNOWN_CURRENCY"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "BUSY — all query slots taken"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "UPSTREAM_TIMEOUT"
          }
        },
        "summary": "Get Export",
        "tags": [
          "exec-compensation"
        ]
      }
    },
