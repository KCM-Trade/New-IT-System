{
  "paths": {
    "/api/v1/cs/fund-risk/export": {
      "get": {
        "description": "Every filtered row as xlsx (stored snapshot values, no replica queries).",
        "operationId": "export_incidents_api_v1_cs_fund_risk_export_get",
        "parameters": [
          {
            "description": "reported_date >= (inclusive)",
            "in": "query",
            "name": "date_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "reported_date >= (inclusive)",
              "title": "Date From"
            }
          },
          {
            "description": "reported_date <= (inclusive)",
            "in": "query",
            "name": "date_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "reported_date <= (inclusive)",
              "title": "Date To"
            }
          },
          {
            "description": "Exact channel label",
            "in": "query",
            "name": "channel",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exact channel label",
              "title": "Channel"
            }
          },
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "deposit",
                    "withdrawal"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Direction"
            }
          },
          {
            "in": "query",
            "name": "authority",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "bank",
                    "police_antifraud",
                    "alipay",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authority"
            }
          },
          {
            "in": "query",
            "name": "frozen_scope",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "none",
                    "one_card",
                    "all_cards",
                    "non_counter",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Frozen Scope"
            }
          },
          {
            "description": "true = result_text is empty",
            "in": "query",
            "name": "pending_result",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "true = result_text is empty",
              "title": "Pending Result"
            }
          },
          {
            "description": "Transaction id or client id (exact)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{1,18}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Transaction id or client id (exact)",
              "title": "Q"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "reported_date",
              "pattern": "^(reported_date|txn_processed_at|id)$",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "default": "desc",
              "pattern": "^(asc|desc)$",
              "title": "Order",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {}
            },
            "description": "xlsx: 台账"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Ledger database or MySQL replica unavailable"
          }
        },
        "summary": "Export Incidents",
        "tags": [
          "cs-fund-risk"
        ]
      }
    },
